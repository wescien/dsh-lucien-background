{
  "name": "@local/aurora-background",
  "version": "2.1.0",
  "private": true,
  "description": "Animated aurora wallpaper behind the DeepSeek Harness Web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wescien/dsh-lucien-background.git"
  },
  "homepage": "https://github.com/wescien/dsh-lucien-background#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "wallpaper",
    "aurora",
    "background"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
